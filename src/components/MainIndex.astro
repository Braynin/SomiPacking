---
import ValoresOptions from "../assets/ValoresOptions.js";
import PaperFitHero from "./PaperFitHero.astro";
import PaperFitSolutions from "./PaperFitSolutions.astro";
import PaperFitWorkflow from "./PaperFitWorkflow.astro";
---

<div class="w-full flex flex-col">
  <PaperFitHero />
  <PaperFitSolutions />
  <PaperFitWorkflow />

  <section
    id="nosotros"
    class="flex py-10 justify-center bg-verdeNosotros mt-10 w-full celular:flex-col items-center"
  >
    <!-- Sección de Texto (40%) -->
    <div
      class="w-2/6 p-6 flex flex-col items-start celular:w-full celular:text-center celular:items-center"
    >
      <h2 class="text-3xl text-verdeClaro font-bold mb-5">NOSOTROS</h2>
      <p class="text-xl text-white mb-5 celular:w-4/5">
        En <span class="font-bold">Somi Packaging</span>, transformamos ideas en
        productos tangibles y personalizados.
      </p>
      <p class="text-xl text-white celular:w-4/5">
        Ofrecemos servicios de impresión, fabricación de empaques y
        merchandising, asegurando que cada creación <span class="font-bold"
          >refleje la identidad y esencia de nuestros clientes.</span
        >
      </p>
    </div>

    <!-- Sección de Video (60%) -->
    <div class="w-3/6 flex justify-center celular:w-full">
      <video autoplay loop muted class="w-full h-full object-contain">
        <source src="./Nosotros-video.mp4" type="video/mp4" />
        Tu navegador no soporta videos.
      </video>
    </div>
  </section>

  <section
    class="flex w-full py-10 escritorio:m-7 celular:flex-col celular:items-center"
  >
    <div
      class="escritorio:w-1/2 celular:w-full celular:m-6 flex flex-col items-center escritorio:border-r-4 border-verdeOscuro"
    >
      <h2
        class="text-3xl font-bold celular:w-full celular:pr-6 celular:pl-6 mb-3 text-center celular:text-justify"
      >
        MISIÓN
      </h2>
      <p
        class="w-3/5 celular:w-full celular:pr-6 celular:pl-6 text-gray-600 text-center celular:text-justify"
      >
        Buscamos proporcionar soluciones innovadoras y personalizadas que
        satisfagan las necesidades del mercado y superen las expectativas de
        nuestros clientes.
      </p>
    </div>
    <div class="escritorio:w-1/2 flex flex-col items-center">
      <h2
        class="text-3xl font-bold w-3/5 text-center mb-3 celular:w-full celular:pr-6 celular:pl-6 celular:mt-7 celular:text-justify"
      >
        VISIÓN
      </h2>
      <p
        class="w-3/5 celular:w-full celular:pr-6 celular:pl-6 text-gray-600 text-center celular:text-justify"
      >
        Ser una empresa líder en empaques sostenibles, ofreciendo productos de
        calidad que refuercen la identidad de cada marca. Nos comprometemos con
        la innovación, el servicio al cliente y el respeto al medio ambiente
        para generar un impacto positivo.
      </p>
    </div>
  </section>
  <section id="trabajos-realizados" class="w-full py-10 mb-7 bg-white">
    <h2 class="text-3xl font-bold text-center pb-5 celular:mb-7">
      PROCESO DE TRABAJO
    </h2>
    <div
      class="mx-auto w-3/5 flex justify-center items-center text-center celular:flex-col celular:w-full"
    >
      <div
        class="flex justify-between items-center gap-20 text-center celular:flex-col celular:items-center"
      >
        {
          ValoresOptions.map((valores) => (
            <div class="flex flex-col items-center w-1/3 celular:w-full">
              <div class="flex items-center space-x-2">
                <span class="text-red-500 text-lg font-bold">
                  {valores.numero}.
                </span>
                <div class="bg-gray-100 rounded-full p-2 w-20 h-20 flex items-center justify-center">
                  <img src={valores.icon} alt="Icono" class=" w-20 h-auto" />
                </div>
              </div>
              <h3 class="mt-4 text-lg font-semibold">{valores.title}</h3>
              <p class="text-gray-600 mt-3 text-sm max-w-xs">
                {valores.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>
