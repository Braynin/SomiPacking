---
import { paperFitBrand, paperFitContact } from "../paper-fit-content";
import PaperFitButton from "./PaperFitButton.astro";
import PaperFitNavigation from "./PaperFitNavigation.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
---

<header class="paper-fit-header">
  <div class="paper-fit-header__container">
    <a
      class="paper-fit-header__brand"
      href={paperFitBrand.homeHref}
      aria-label="Ir al inicio"
    >
      <img
        src={paperFitBrand.logoSrc}
        alt={paperFitBrand.logoAlt}
        width="255"
        height="50"
      />
    </a>

    <PaperFitNavigation
      className="paper-fit-header__desktop-nav"
      ariaLabel="Navegación principal"
    />

    <PaperFitButton
      className="paper-fit-header__cta"
      href={paperFitContact.whatsappUrl}
      external
    >
      <WhatsAppIcon slot="icon" />
      {paperFitContact.whatsappLabel}
    </PaperFitButton>

    <details class="paper-fit-header__mobile-menu" data-paper-fit-mobile-menu>
      <summary
        aria-label="Abrir menú de navegación"
        data-paper-fit-mobile-menu-trigger
      >
        <span></span><span></span><span></span>
      </summary>
      <div class="paper-fit-header__mobile-content">
        <PaperFitNavigation ariaLabel="Navegación móvil" />
        <PaperFitButton
          className="paper-fit-header__mobile-cta"
          href={paperFitContact.whatsappUrl}
          external
        >
          <WhatsAppIcon slot="icon" />
          {paperFitContact.whatsappLabel}
        </PaperFitButton>
      </div>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>(
    "[data-paper-fit-mobile-menu]",
  );
  const mobileMenuTrigger = document.querySelector<HTMLElement>(
    "[data-paper-fit-mobile-menu-trigger]",
  );

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.removeAttribute("open");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !mobileMenu?.open) return;

    mobileMenu.removeAttribute("open");
    mobileMenuTrigger?.focus();
  });

  document.addEventListener("pointerdown", (event) => {
    if (!mobileMenu?.open || !(event.target instanceof Node)) return;
    if (!mobileMenu.contains(event.target)) mobileMenu.removeAttribute("open");
  });
</script>

<style>
  .paper-fit-header {
    position: sticky;
    z-index: 20;
    top: 0;
    background: var(--paper-fit-color-surface);
    box-shadow: 0 0.125rem 0.75rem rgb(17 14 107 / 8%);
  }

  .paper-fit-header__container {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: var(--paper-fit-header-height);
    width: min(
      100% - (var(--paper-fit-container-gutter) * 2),
      var(--paper-fit-container-max-width)
    );
    margin-inline: auto;
  }

  .paper-fit-header__brand {
    justify-self: start;
  }

  .paper-fit-header__brand img {
    display: block;
    width: clamp(8.75rem, 13vw, 11.25rem);
    height: auto;
  }

  :global(.paper-fit-header__desktop-nav) {
    justify-self: center;
  }

  :global(.paper-fit-header__cta) {
    justify-self: end;
  }

  .paper-fit-header__mobile-menu {
    display: none;
  }

  @media (max-width: 52rem) {
    .paper-fit-header__container {
      display: flex;
      justify-content: space-between;
    }

    :global(.paper-fit-header__desktop-nav),
    :global(.paper-fit-button.paper-fit-header__cta) {
      display: none;
    }

    .paper-fit-header__mobile-menu {
      display: block;
    }

    .paper-fit-header__mobile-menu summary {
      display: grid;
      gap: 0.25rem;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0.75rem;
      cursor: pointer;
      list-style: none;
      background: transparent;
      border: 0;
      border-radius: var(--paper-fit-radius-sm);
    }

    .paper-fit-header__mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .paper-fit-header__mobile-menu summary span {
      display: block;
      width: 100%;
      height: 0.125rem;
      background: var(--paper-fit-color-primary);
      transition:
        transform 150ms ease,
        opacity 150ms ease;
    }

    .paper-fit-header__mobile-menu[open] summary span:first-child {
      transform: translateY(0.375rem) rotate(45deg);
    }

    .paper-fit-header__mobile-menu[open] summary span:nth-child(2) {
      opacity: 0;
    }

    .paper-fit-header__mobile-menu[open] summary span:last-child {
      transform: translateY(-0.375rem) rotate(-45deg);
    }

    .paper-fit-header__mobile-content {
      position: absolute;
      top: 100%;
      right: 0;
      z-index: 1;
      display: grid;
      gap: 1.5rem;
      width: min(90vw, 22rem);
      padding: 1.5rem;
      background: var(--paper-fit-color-surface);
      border: 1px solid rgb(17 14 107 / 12%);
      border-radius: var(--paper-fit-radius-sm);
      box-shadow: var(--paper-fit-shadow-card);
    }

    .paper-fit-header__mobile-content :global(.paper-fit-navigation ul) {
      display: grid;
      gap: 1rem;
    }

    .paper-fit-header__mobile-content :global(.paper-fit-navigation a) {
      display: block;
      font-size: 1rem;
    }

    :global(.paper-fit-header__mobile-cta) {
      width: 100%;
    }
  }

  @media (max-width: 36rem) {
    .paper-fit-header__mobile-content {
      left: 0;
      width: 100%;
    }
  }
</style>
