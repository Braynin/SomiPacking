---
import { paperFitContact } from "../paper-fit-content";
import PaperFitButton from "./PaperFitButton.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  imageSrc: string;
  imageAlt: string;
  iconSrc: string;
  iconVariant: "primary" | "accent";
  title: string;
  materials: readonly string[];
  applications: readonly string[];
  buttonLabel: string;
  whatsappMessage: string;
}

const {
  imageSrc,
  imageAlt,
  iconSrc,
  iconVariant,
  title,
  materials,
  applications,
  buttonLabel,
  whatsappMessage,
} = Astro.props;

const whatsappUrl = `${paperFitContact.whatsapp.url}?text=${encodeURIComponent(whatsappMessage)}`;

const formatMobileItems = (items: readonly string[]) => items.join(" · ");

const featureGroups = [
  { icon: "material", label: "Material", items: materials },
  { icon: "applications", label: "Aplicaciones", items: applications },
] as const;
---

<article class="paper-fit-solution-card">
  <figure class="paper-fit-solution-card__figure">
    <img
      class="paper-fit-solution-card__image"
      src={imageSrc}
      alt={imageAlt}
      width="1080"
      height="1080"
      loading="lazy"
      decoding="async"
    />
  </figure>

  <span
    class:list={[
      "paper-fit-solution-card__icon",
      `paper-fit-solution-card__icon--${iconVariant}`,
    ]}
  >
    <img
      src={iconSrc}
      alt=""
      aria-hidden="true"
      width="36"
      height="36"
      loading="lazy"
      decoding="async"
    />
  </span>

  <div class="paper-fit-solution-card__content">
    <div class="paper-fit-solution-card__body">
      <h3 class="paper-fit-solution-card__title">
        {title}
      </h3>

      <div class="paper-fit-solution-card__mobile-details">
        <p>
          <strong>Material:</strong>
          {formatMobileItems(materials)}
        </p>
        <p>
          <strong>Aplicaciones:</strong>
          {formatMobileItems(applications)}
        </p>
      </div>

      <div class="paper-fit-solution-card__details">
        {
          featureGroups.map((group) => (
            <section class="paper-fit-solution-card__group">
              <h4 class="paper-fit-solution-card__group-title">
                <span
                  class="paper-fit-solution-card__group-icon"
                  aria-hidden="true"
                >
                  {group.icon === "material" ? (
                    <svg viewBox="0 0 16 16">
                      <path d="m2 5 6-3 6 3-6 3-6-3Z" />
                      <path d="m2 8 6 3 6-3" />
                      <path d="m2 11 6 3 6-3" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 16 16">
                      <path d="m2.25 5 5.75-3 5.75 3v6L8 14l-5.75-3V5Z" />
                      <path d="m2.25 5 5.75 3 5.75-3M8 8v6" />
                      <path d="m9.65 10.75.8.8 1.75-1.85" />
                    </svg>
                  )}
                </span>
                <span>{group.label}</span>
              </h4>

              <ul class="paper-fit-solution-card__list">
                {group.items.map((item) => (
                  <li class="paper-fit-solution-card__list-item">
                    <span
                      class="paper-fit-solution-card__check"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 12 12">
                        <path d="m2.5 6.2 2.2 2.1 4.8-4.7" />
                      </svg>
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    <PaperFitButton
      className="paper-fit-solution-card__button"
      href={whatsappUrl}
      external
    >
      <WhatsAppIcon slot="icon" />
      {buttonLabel}
    </PaperFitButton>
  </div>

  <style>
    .paper-fit-solution-card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-width: 0;
      overflow: hidden;
      background: var(--paper-fit-color-surface);
      border: 1px solid rgb(17 14 107 / 8%);
      border-radius: 0.65rem;
      box-shadow: var(--paper-fit-shadow-card);
    }

    .paper-fit-solution-card__figure {
      position: relative;
      flex-shrink: 0;
      margin: 0;
      overflow: hidden;
      background: #f4f4f5;
    }

    .paper-fit-solution-card__image {
      display: block;
      width: 100%;
      aspect-ratio: 1.2 / 1;
      object-fit: cover;
    }

    .paper-fit-solution-card__content {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding: 0.9rem 0.8rem 0.8rem;
    }

    .paper-fit-solution-card__icon {
      position: absolute;
      top: 0.7rem;
      left: 0.7rem;
      display: grid;
      place-items: center;
      width: 2.7rem;
      height: 2.7rem;
      border-radius: 50%;
      box-shadow: 0 0.2rem 0.65rem rgb(8 45 103 / 15%);
    }

    .paper-fit-solution-card__icon--primary {
      background: var(--paper-fit-color-primary);
    }

    .paper-fit-solution-card__icon--accent {
      background: var(--paper-fit-color-accent);
    }

    .paper-fit-solution-card__icon img {
      display: block;
      width: 1.45rem;
      height: 1.45rem;
    }

    .paper-fit-solution-card__title {
      margin: 0 0 0.85rem;
      color: var(--paper-fit-color-primary);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    .paper-fit-solution-card__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      min-width: 0;
    }

    .paper-fit-solution-card__mobile-details {
      display: none;
    }

    .paper-fit-solution-card__details {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .paper-fit-solution-card__group-title {
      display: flex;
      gap: 0.3rem;
      align-items: center;
      margin: 0 0 0.45rem;
      color: var(--paper-fit-color-accent-hover);
      font-size: 0.62rem;
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
    }

    .paper-fit-solution-card__group-title::after {
      width: auto;
      height: 1px;
      flex: 1;
      content: "";
      background: rgb(0 190 127 / 35%);
    }

    .paper-fit-solution-card__group-icon {
      display: grid;
      flex: 0 0 auto;
      place-items: center;
      width: 1.56rem;
      height: 1.56rem;
    }

    .paper-fit-solution-card__group-icon svg {
      display: block;
      width: 100%;
      height: 100%;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.25;
    }

    .paper-fit-solution-card__list {
      display: grid;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .paper-fit-solution-card__list-item {
      display: flex;
      gap: 0.35rem;
      align-items: center;
      color: var(--paper-fit-color-text);
      font-size: 0.7rem;
      line-height: 1.25;
    }

    .paper-fit-solution-card__check {
      display: grid;
      flex: 0 0 auto;
      place-items: center;
      width: 0.72rem;
      height: 0.72rem;
      color: var(--paper-fit-color-surface);
      background: var(--paper-fit-color-accent-hover);
      border-radius: 50%;
    }

    .paper-fit-solution-card__check svg {
      display: block;
      width: 0.48rem;
      height: 0.48rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2;
    }

    .paper-fit-solution-card :global(.paper-fit-solution-card__button) {
      width: 100%;
      min-height: 2.35rem;
      gap: 0.35rem;
      margin-top: auto;
      padding: 0.6rem 0.4rem;
      font-size: 0.72rem;
      white-space: nowrap;
    }

    .paper-fit-solution-card :global(.paper-fit-solution-card__button svg) {
      width: 1rem;
      height: 1rem;
    }

    @media (max-width: 70rem) {
      .paper-fit-solution-card__content {
        padding: 1rem;
      }

      .paper-fit-solution-card__title {
        font-size: 0.95rem;
      }

      .paper-fit-solution-card__icon {
        width: 3rem;
        height: 3rem;
      }

      .paper-fit-solution-card__icon img {
        width: 1.6rem;
        height: 1.6rem;
      }

      .paper-fit-solution-card__group-title {
        font-size: 0.7rem;
      }

      .paper-fit-solution-card__list-item {
        font-size: 0.8rem;
      }

      .paper-fit-solution-card :global(.paper-fit-solution-card__button) {
        min-height: 2.6rem;
        font-size: 0.84rem;
      }
    }

    @media (max-width: 47rem) {
      .paper-fit-solution-card {
        min-height: 0;
        border: 1px solid rgb(17 14 107 / 10%);
        border-radius: 0.7rem;
      }

      .paper-fit-solution-card__figure {
        display: none;
      }

      .paper-fit-solution-card__icon {
        display: none;
      }

      .paper-fit-solution-card__content {
        gap: 0.8rem;
        padding: 0.9rem 1rem 1rem;
      }

      .paper-fit-solution-card__body {
        gap: 0.45rem;
      }

      .paper-fit-solution-card__title {
        margin: 0;
        font-size: 0.98rem;
        line-height: 1.2;
        white-space: normal;
      }

      .paper-fit-solution-card__mobile-details {
        display: grid;
        gap: 0.25rem;
      }

      .paper-fit-solution-card__mobile-details p {
        margin: 0;
        color: var(--paper-fit-color-muted);
        font-size: 0.78rem;
        line-height: 1.35;
      }

      .paper-fit-solution-card__mobile-details strong {
        color: var(--paper-fit-color-primary);
        font-weight: 800;
      }

      .paper-fit-solution-card__details {
        display: none;
      }

      .paper-fit-solution-card :global(.paper-fit-solution-card__button) {
        align-self: flex-start;
        align-items: center;
        justify-content: center;
        width: fit-content;
        max-width: 100%;
        min-height: 2.45rem;
        margin-top: 0;
        padding-inline: 0.85rem;
        font-size: 0.8rem;
        line-height: 1rem;
      }

      .paper-fit-solution-card :global(.paper-fit-solution-card__button svg) {
        display: block;
        flex: 0 0 auto;
        align-self: center;
        width: 1.125rem;
        height: 1.125rem;
        transform: none;
      }

      .paper-fit-solution-card :global(.paper-fit-solution-card__button span) {
        display: block;
        line-height: 1rem;
      }
    }
  </style>
</article>
