---
import { paperFitContact } from "../paper-fit-content";
import PaperFitButton from "./PaperFitButton.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  imageSrc: string;
  imageAlt: string;
  iconSrc: string;
  iconVariant: "primary" | "accent";
  title: string;
  materials: readonly string[];
  applications: readonly string[];
  buttonLabel: string;
  whatsappMessage: string;
}

const {
  imageSrc,
  imageAlt,
  iconSrc,
  iconVariant,
  title,
  materials,
  applications,
  buttonLabel,
  whatsappMessage,
} = Astro.props;

const whatsappUrl = `${paperFitContact.whatsappUrl}?text=${encodeURIComponent(whatsappMessage)}`;

const featureGroups = [
  { icon: "material", label: "Material", items: materials },
  { icon: "applications", label: "Aplicaciones", items: applications },
] as const;
---

<article class="paper-fit-solution-card">
  <figure class="paper-fit-solution-card__figure">
    <img
      class="paper-fit-solution-card__image"
      src={imageSrc}
      alt={imageAlt}
      width="1080"
      height="1080"
      loading="lazy"
      decoding="async"
    />

    <span
      class:list={[
        "paper-fit-solution-card__icon",
        `paper-fit-solution-card__icon--${iconVariant}`,
      ]}
    >
      <img
        src={iconSrc}
        alt=""
        aria-hidden="true"
        width="36"
        height="36"
        loading="lazy"
        decoding="async"
      />
    </span>
  </figure>

  <div class="paper-fit-solution-card__content">
    <h3 class="paper-fit-solution-card__title">
      {title}
    </h3>

    <div class="paper-fit-solution-card__details">
      {
        featureGroups.map((group) => (
          <section class="paper-fit-solution-card__group">
            <h4 class="paper-fit-solution-card__group-title">
              <span
                class="paper-fit-solution-card__group-icon"
                aria-hidden="true"
              >
                {group.icon === "material" ? (
                  <svg viewBox="0 0 16 16">
                    <path d="M3.25 2.25h7.5a2 2 0 0 1 2 2v9.5h-7.5a2 2 0 0 1-2-2v-9.5Zm2 2v7.5h5.5v-7.5h-5.5Z" />
                    <path d="M2 4h1.25v7.75A3.25 3.25 0 0 0 6.5 15h6.25v-1.25H6.5a2 2 0 0 1-2-2V4H2Z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 16 16">
                    <path d="M2 2h5v5H2V2Zm7 0h5v5H9V2ZM2 9h5v5H2V9Zm7 0h5v5H9V9Zm-5.5-5.5v2h2v-2h-2Zm7 0v2h2v-2h-2Zm-7 7v2h2v-2h-2Zm7 0v2h2v-2h-2Z" />
                  </svg>
                )}
              </span>
              <span>{group.label}</span>
            </h4>

            <ul class="paper-fit-solution-card__list">
              {group.items.map((item) => (
                <li class="paper-fit-solution-card__list-item">
                  <span
                    class="paper-fit-solution-card__check"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12">
                      <path d="m2.5 6.2 2.2 2.1 4.8-4.7" />
                    </svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <PaperFitButton
      className="paper-fit-solution-card__button"
      href={whatsappUrl}
      external
    >
      <WhatsAppIcon slot="icon" />
      {buttonLabel}
    </PaperFitButton>
  </div>

  <style>
    .paper-fit-solution-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-width: 0;
      overflow: hidden;
      background: var(--paper-fit-color-surface);
      border: 1px solid rgb(17 14 107 / 8%);
      border-radius: 0.65rem;
      box-shadow: var(--paper-fit-shadow-card);
    }

    .paper-fit-solution-card__figure {
      position: relative;
      flex-shrink: 0;
      margin: 0;
      overflow: hidden;
      background: #f4f4f5;
    }

    .paper-fit-solution-card__image {
      display: block;
      width: 100%;
      aspect-ratio: 1.2 / 1;
      object-fit: cover;
    }

    .paper-fit-solution-card__content {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding: 0.9rem 0.8rem 0.8rem;
    }

    .paper-fit-solution-card__icon {
      position: absolute;
      top: 0.7rem;
      left: 0.7rem;
      display: grid;
      place-items: center;
      width: 2.7rem;
      height: 2.7rem;
      border-radius: 50%;
      box-shadow: 0 0.2rem 0.65rem rgb(8 45 103 / 15%);
    }

    .paper-fit-solution-card__icon--primary {
      background: var(--paper-fit-color-primary);
    }

    .paper-fit-solution-card__icon--accent {
      background: var(--paper-fit-color-accent);
    }

    .paper-fit-solution-card__icon img {
      display: block;
      width: 1.45rem;
      height: 1.45rem;
    }

    .paper-fit-solution-card__title {
      margin: 0 0 0.85rem;
      color: var(--paper-fit-color-primary);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    .paper-fit-solution-card__details {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .paper-fit-solution-card__group-title {
      display: flex;
      gap: 0.3rem;
      align-items: center;
      margin: 0 0 0.45rem;
      color: var(--paper-fit-color-accent-hover);
      font-size: 0.62rem;
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
    }

    .paper-fit-solution-card__group-title::after {
      width: auto;
      height: 1px;
      flex: 1;
      content: "";
      background: rgb(0 190 127 / 35%);
    }

    .paper-fit-solution-card__group-icon {
      display: grid;
      flex: 0 0 auto;
      place-items: center;
      width: 0.78rem;
      height: 0.78rem;
    }

    .paper-fit-solution-card__group-icon svg {
      display: block;
      width: 100%;
      height: 100%;
      fill: currentColor;
    }

    .paper-fit-solution-card__list {
      display: grid;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .paper-fit-solution-card__list-item {
      display: flex;
      gap: 0.35rem;
      align-items: center;
      color: var(--paper-fit-color-text);
      font-size: 0.7rem;
      line-height: 1.25;
    }

    .paper-fit-solution-card__check {
      display: grid;
      flex: 0 0 auto;
      place-items: center;
      width: 0.72rem;
      height: 0.72rem;
      color: var(--paper-fit-color-surface);
      background: var(--paper-fit-color-accent-hover);
      border-radius: 50%;
    }

    .paper-fit-solution-card__check svg {
      display: block;
      width: 0.48rem;
      height: 0.48rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2;
    }

    .paper-fit-solution-card :global(.paper-fit-solution-card__button) {
      width: 100%;
      min-height: 2.35rem;
      gap: 0.35rem;
      margin-top: auto;
      padding: 0.6rem 0.4rem;
      font-size: 0.72rem;
      white-space: nowrap;
    }

    .paper-fit-solution-card :global(.paper-fit-solution-card__button svg) {
      width: 1rem;
      height: 1rem;
    }

    @media (max-width: 70rem) {
      .paper-fit-solution-card__content {
        padding: 1rem;
      }

      .paper-fit-solution-card__title {
        font-size: 0.95rem;
      }

      .paper-fit-solution-card__icon {
        width: 3rem;
        height: 3rem;
      }

      .paper-fit-solution-card__icon img {
        width: 1.6rem;
        height: 1.6rem;
      }

      .paper-fit-solution-card__group-title {
        font-size: 0.7rem;
      }

      .paper-fit-solution-card__list-item {
        font-size: 0.8rem;
      }

      .paper-fit-solution-card :global(.paper-fit-solution-card__button) {
        min-height: 2.6rem;
        font-size: 0.84rem;
      }
    }

    @media (max-width: 36rem) {
      .paper-fit-solution-card__image {
        aspect-ratio: 1.35 / 1;
      }

      .paper-fit-solution-card__content {
        padding: 1.1rem;
      }

      .paper-fit-solution-card__title {
        font-size: 1.05rem;
      }

      .paper-fit-solution-card__group-title {
        font-size: 0.72rem;
      }

      .paper-fit-solution-card__list-item {
        font-size: 0.86rem;
      }

      .paper-fit-solution-card :global(.paper-fit-solution-card__button) {
        min-height: 2.75rem;
        font-size: 0.88rem;
      }
    }
  </style>
</article>
