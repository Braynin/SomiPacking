---
import { paperFitSolutions } from "../paper-fit-content";
import PaperFitSection from "./PaperFitSection.astro";
import PaperFitSolutionCard from "./PaperFitSolutionCard.astro";

const { title, items } = paperFitSolutions;
---

<PaperFitSection
  id="nuestras-soluciones"
  labelledBy="paper-fit-solutions-title"
  class="paper-fit-solutions"
>
  <div class="paper-fit-solutions__header">
    <h2 id="paper-fit-solutions-title" class="paper-fit-solutions__title">
      {title}
    </h2>
  </div>

  <div class="paper-fit-solutions__grid">
    {items.map((solution) => <PaperFitSolutionCard {...solution} />)}
  </div>
</PaperFitSection>

<style>
  .paper-fit-solutions__header {
    margin-bottom: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .paper-fit-solutions__title {
    position: relative;
    margin: 0;
    color: var(--paper-fit-color-primary);
    font-size: var(--paper-fit-font-h2);
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  .paper-fit-solutions__title::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 0.2rem;
    margin: 0.75rem auto 0;
    background: var(--paper-fit-color-accent);
    border-radius: 999px;
  }

  .paper-fit-solutions__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (max-width: 70rem) {
    .paper-fit-solutions__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (max-width: 52rem) {
    .paper-fit-solutions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47rem) {
    .paper-fit-solutions__header {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 36rem) {
    .paper-fit-solutions__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
