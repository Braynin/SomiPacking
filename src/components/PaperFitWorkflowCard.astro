---
interface Props {
  number: number;
  iconSrc: string;
  iconAlt: string;
  title: string;
  description: string;
}

const { number, iconSrc, iconAlt, title, description } = Astro.props;
---

<article class="paper-fit-workflow-card">
  <span class="paper-fit-workflow-card__number">
    {number}
  </span>
  <div class="paper-fit-workflow-card__icon-wrapper">
    <img
      class="paper-fit-workflow-card__icon"
      src={iconSrc}
      alt={iconAlt}
      width="72"
      height="72"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="paper-fit-workflow-card__content">
    <h3 class="paper-fit-workflow-card__title">
      {title}
    </h3>

    <p class="paper-fit-workflow-card__description">
      {description}
    </p>
  </div>
</article>

<style>
  .paper-fit-workflow-card__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 5.5rem;
    margin-bottom: 1rem;
  }
  .paper-fit-workflow-card__content {
    display: flex;
    flex-direction: column;

    flex: 1;
    width: 100%;

    align-items: center;
    justify-content: space-between;
  }
  .paper-fit-workflow-card {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 17rem; /* en vez de min-height */
    padding: 2rem 1.5rem;

    border: 2px solid rgb(255 255 255 / 18%);
    border-radius: 1rem;

    background: transparent;
    text-align: center;
  }

  .paper-fit-workflow-card__number {
    position: absolute;

    top: 1rem;
    left: 1rem;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1.75rem;
    height: 1.75rem;

    border-radius: 999px;

    background: var(--paper-fit-color-surface);
    color: var(--paper-fit-color-accent);

    font-size: 0.85rem;
    font-weight: 800;
  }

  .paper-fit-workflow-card__icon {
    display: block;

    width: auto;
    height: 4.75rem;

    flex-shrink: 0;
  }
  .paper-fit-workflow-card__title {
    display: block;
    max-width: 13rem;
    height: 3.5rem;
    margin: 0 0 0.8rem;
    color: #fff;
    font-size: var(--paper-fit-font-h3);
    font-weight: 800;
    line-height: 1.2;
  }

  .paper-fit-workflow-card__description {
    display: block;
    max-width: 13rem;
    height: 5rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--paper-fit-font-body);
    line-height: 1.55;
  }
  @media (max-width: 64rem) and (min-width: 48rem) {
    .paper-fit-workflow-card {
      height: 15rem;
      padding: 1.5rem 1rem;
    }

    .paper-fit-workflow-card__icon-wrapper {
      height: 4rem;
      margin-bottom: 1rem;
    }

    .paper-fit-workflow-card__icon {
      height: 3.75rem;
    }

    .paper-fit-workflow-card__title {
      font-size: 1.25rem;
      min-height: 3rem;
    }

    .paper-fit-workflow-card__description {
      font-size: 0.65rem;
      min-height: 4rem;
    }
  }
  @media (max-width: 47rem) {
    .paper-fit-workflow-card {
      display: none;
    }
  }
</style>
